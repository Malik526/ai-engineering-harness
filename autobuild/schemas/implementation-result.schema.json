{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobuild.local/schemas/implementation-result.schema.json",
  "title": "Implementer invocation result",
  "description": "runs/<run-id>/implementation/result.json. Written by the controller: how the provider process ended (facts the controller observed) plus the implementer's own report (supplemental claims, never evidence).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "implementation_id", "provider", "role", "session_id",
    "exit_code", "timed_out", "terminated", "duration_seconds", "report_status", "report_error", "reported"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "implementation_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "role": { "enum": ["planner", "implementer", "reviewer"] },
    "session_id": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "timed_out": { "type": "boolean" },
    "terminated": { "type": "boolean" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "report_status": { "enum": ["valid", "invalid", "missing"] },
    "report_error": { "type": ["string", "null"] },
    "failure": {
      "description": "Adapter-classified provider/session failure (provider_failures.py kinds); null on success.",
      "type": ["object", "null"], "additionalProperties": false, "required": ["kind", "detail"],
      "properties": { "kind": { "type": "string", "minLength": 1 }, "detail": { "type": "string" } }
    },
    "reported": {
      "description": "The implementer's report (implementation-report.schema.json), or null when missing/invalid.",
      "oneOf": [{ "type": "null" }, { "type": "object" }]
    }
  }
}
