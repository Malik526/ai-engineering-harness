{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobuild.local/schemas/config.schema.json",
  "title": "Autobuild project configuration",
  "description": "Per-project .autobuild/config.yaml. The only autobuild file a project owns besides its run artifacts; everything else lives in the shared core.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "agents", "git", "paths", "limits", "validation", "notifications", "control"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "agents": {
      "description": "Which provider fills each engineering role. Providers must exist in providers/registry.yaml and support the role; one provider may fill every role.",
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "implementer", "reviewer"],
      "properties": {
        "planner": { "$ref": "#/$defs/role_assignment" },
        "implementer": { "$ref": "#/$defs/role_assignment" },
        "reviewer": { "$ref": "#/$defs/role_assignment" }
      }
    },
    "providers": {
      "description": "Optional per-provider overrides, keyed by registry id.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/provider_id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "description": "Executable to run instead of the registry default.", "type": "string", "minLength": 1 },
          "model": { "description": "Model to request; the provider default when omitted.", "type": "string", "minLength": 1 }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_branches", "branch_prefix"],
      "properties": {
        "protected_branches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "branch_prefix": {
          "description": "Prefix for every automation branch, e.g. 'agent/'. Must end with '/'.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*/$"
        },
        "default_base_branch": {
          "description": "Branch new runs start from when `autobuild run --base` is not given. Defaults to the first protected branch.",
          "type": "string",
          "minLength": 1
        },
        "worktree_root": {
          "description": "Directory that holds run worktrees (absolute, ~, or relative to the project root). Must be outside the project. Defaults to '<project>.worktrees' next to the project.",
          "type": "string",
          "minLength": 1
        },
        "checkpoint_commits": {
          "description": "Whether the controller may create one checkpoint commit on the run branch after validation passes. Never pushes. Defaults to false.",
          "type": "boolean"
        }
      }
    },
    "paths": {
      "description": "Repository-relative paths. Absolute paths and '..' are rejected so a project config cannot point agents outside the repository.",
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap", "project_state", "adr_directory", "runs_directory"],
      "properties": {
        "roadmap": { "$ref": "#/$defs/relative_path" },
        "project_state": { "$ref": "#/$defs/relative_path" },
        "adr_directory": { "$ref": "#/$defs/relative_path" },
        "runs_directory": { "$ref": "#/$defs/relative_path" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_review_cycles", "max_consecutive_implementations"],
      "properties": {
        "max_review_cycles": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_consecutive_implementations": { "type": "integer", "minimum": 1, "maximum": 50 },
        "implementer_timeout_seconds": {
          "description": "Wall-clock limit for one implementer invocation. Defaults to 3600.",
          "type": "integer", "minimum": 60, "maximum": 86400
        },
        "reviewer_timeout_seconds": {
          "description": "Wall-clock limit for one fresh reviewer invocation. Defaults to 3600.",
          "type": "integer", "minimum": 60, "maximum": 86400
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser_tool", "require_clean_git_before_start"],
      "properties": {
        "browser_tool": { "enum": ["none", "playwright", "agent-browser"] },
        "require_clean_git_before_start": { "type": "boolean" },
        "commands": {
          "description": "Commands the controller runs in the worktree after implementation. Only these results are authoritative validation evidence.",
          "type": "array",
          "items": { "$ref": "#/$defs/validation_command" }
        },
        "runtime_paths": {
          "description": "Ignored dependency/runtime directories mounted read-only into the disposable validation snapshot.",
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "browser_gates": {
          "description": "Controller-owned argv commands, isolated with Bubblewrap; outputs relative to AUTOBUILD_BROWSER_OUTPUT.",
          "type": "array", "maxItems": 20,
          "items": { "$ref": "#/$defs/browser_gate" }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "provider"],
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["console", "file", "email"] }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_stop_enabled", "provider"],
      "properties": {
        "remote_stop_enabled": { "type": "boolean" },
        "provider": { "enum": ["none", "file", "github", "supabase"] }
      },
      "if": { "properties": { "remote_stop_enabled": { "const": true } } },
      "then": { "properties": { "provider": { "not": { "const": "none" } } } }
    }
  },
  "$defs": {
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "browser_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["browser", "e2e"] },
        "command": { "$ref": "#/$defs/argv" },
        "cwd": { "$ref": "#/$defs/relative_path" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "required": { "type": "boolean", "default": true },
        "enabled": { "type": "boolean", "default": true },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "artifacts": { "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" } },
        "service": {
          "type": "object", "additionalProperties": false,
          "required": ["command", "ready_url"],
          "properties": {
            "command": { "$ref": "#/$defs/argv" },
            "cwd": { "$ref": "#/$defs/relative_path" },
            "ready_url": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
          }
        }
      }
    },
    "validation_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "oneOf": [
        { "required": ["command"], "not": { "required": ["run"] } },
        { "required": ["run"], "not": { "required": ["command"] } }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["setup", "test", "lint", "typecheck", "build", "other"] },
        "run": {
          "description": "Legacy shell command, confined identically but discouraged. Prefer command argv.",
          "type": "string", "minLength": 1
        },
        "command": { "$ref": "#/$defs/argv" },
        "cwd": { "$ref": "#/$defs/relative_path" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "required": { "description": "A failing required command fails the run. Defaults to true.", "type": "boolean" },
        "network": { "description": "Network policy; defaults to none. Host access is explicit and visible in evidence.",
          "enum": ["none", "host"] },
        "paths": {
          "description": "Run only when a changed file matches one of these fnmatch patterns; otherwise recorded as skipped.",
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "role_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": { "provider": { "$ref": "#/$defs/provider_id" } }
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    }
  }
}
